FROM ghcr.io/vindeckyy/presswork:latest
ARG MAINTAINER_LABEL
ARG SOURCE_URL_LABEL
ARG IMAGE_URL_LABEL
ARG DOCUMENTATION_URL_LABEL
LABEL org.opencontainers.image.authors="$MAINTAINER_LABEL" \
      org.opencontainers.image.source="$SOURCE_URL_LABEL" \
      org.opencontainers.image.documentation="$DOCUMENTATION_URL_LABEL" \
      org.opencontainers.image.url="$IMAGE_URL_LABEL" \
      org.opencontainers.image.licenses="Apache-2.0 OR MIT" \
      org.opencontainers.image.title="presswork print server image" \
      org.opencontainers.image.description="Docker image running presswork, a memory-safe drop-in replacement for the CUPS print server written in Rust."

# Same admin-user convention as the cupsd image (print/print in lpadmin).
RUN useradd \
  --groups=lp,lpadmin \
  --create-home \
  --home-dir=/home/print \
  --shell=/bin/bash \
  print \
&& echo 'print:print' | chpasswd

# This will use port 631
EXPOSE 631

# Reuse this directory's configuration file
COPY --chown=root:lp cupsd.conf /etc/cups/cupsd.conf

CMD ["/usr/sbin/cupsd", "-f"]
